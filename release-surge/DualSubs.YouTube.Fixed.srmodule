#!name = 🍿 DualSubs YouTube Fixed (Shadowrocket)
#!desc = UNTESTED on Shadowrocket｜修复 YouTube 字幕加载失败
#!author = Original: DualSubs / VirgilClyne | Fixed by Eugene-Prime
#!homepage = https://github.com/Eugene-Prime/YouTube-subtitle
#!version = 1.1.0-local

# This module has not been tested on Shadowrocket. / 本模块尚未在 Shadowrocket 实机测试。

[Rule]
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[Script]
DualSubs.YouTube.Player.request.json = type=http-request, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.request.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.Player.response.json = type=http-response, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.response.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.Player.request.proto = type=http-request, pattern=^https?:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.request.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.Player.response.proto = type=http-response, pattern=^https?:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.response.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.GetWatch.response.proto = type=http-response, pattern=^https?:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.response.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.TimedText.request = type=http-request, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.request.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.Composite.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External), requires-body=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/Composite.Subtitles.response.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN
DualSubs.YouTube.Translate.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, requires-body=1, timeout=7, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/Translate.response.bundle.js?v=1.0.4-local, argument=Type=Translate&Types=Translate&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&Debug=false&LogLevel=WARN

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, youtubei-att.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
