#!name = 🍿 DualSubs YouTube Fixed
#!desc = 修复 YouTube 字幕加载失败｜Fixed: prevents subtitle loading failures
#!author = Original: DualSubs / VirgilClyne | Fixed by Eugene-Prime
#!homepage = https://github.com/Eugene-Prime/YouTube-subtitle
#!version = 1.1.0-local
#!arguments = Type:Translate,AutoCC:true,Position:Forward,Vendor:Google,ShowOnly:false,Debug:false,LogLevel:WARN
#!arguments-desc = Type: 字幕模式（推荐 Translate：翻译生成双语字幕；Official：YouTube 官方翻译合成；External：外挂字幕）\nAutoCC: 自动为原字幕添加目标语言；首次使用请在 YouTube 选择 自动翻译 → 中文（简体）\nPosition: 双语顺序（Forward：原文在上；Reverse：译文在上）\nVendor: 翻译服务（默认 Google；Microsoft、DeepL 等需要自行配置凭据）\nShowOnly: true 只显示译文；false 显示原文和译文\nDebug: true 输出 Surge 脚本诊断日志；排障后请关闭\nLogLevel: 日志级别（正常使用推荐 WARN；调试时使用 DEBUG）

[Script]
🍿 DualSubs.YouTube.Player.request.json = type=http-request, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.request.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.Player.response.json = type=http-response, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.response.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.Player.request.proto = type=http-request, pattern=^https?:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.request.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.Player.response.proto = type=http-response, pattern=^https?:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.response.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.GetWatch.response.proto = type=http-response, pattern=^https?:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.response.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.TimedText.request = type=http-request, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$, engine=webview, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/YouTube.request.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.Composite.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External), requires-body=1, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/Composite.Subtitles.response.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}
🍿 DualSubs.YouTube.Translate.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, requires-body=1, timeout=7, debug={{{Debug}}}, script-path=https://raw.githubusercontent.com/Eugene-Prime/YouTube-subtitle/main/release-surge/Translate.response.bundle.js?v=1.0.4-local, argument=Type={{{Type}}}&AutoCC={{{AutoCC}}}&Position={{{Position}}}&Vendor={{{Vendor}}}&ShowOnly={{{ShowOnly}}}&Debug={{{Debug}}}&LogLevel={{{LogLevel}}}

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, youtubei-att.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
